@startuml webcam_sequence
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam shadowing false
skinparam SequenceGroupBorderThickness 1.5

skinparam participant {
    BackgroundColor<<guest>>   #DDEEFF
    BorderColor<<guest>>       #2255AA
    FontColor<<guest>>         #1A3D6E
    BackgroundColor<<wit>>     #FFE8D6
    BorderColor<<wit>>         #CC5500
    FontColor<<wit>>           #7A2800
    BackgroundColor<<host>>    #DFFFDF
    BorderColor<<host>>        #2A7A2A
    FontColor<<host>>          #1B4A1B
    BackgroundColor<<hw>>      #FFF3CC
    BorderColor<<hw>>          #B8860B
}

title <size:15><b>WASI-USB Webcam — Sequence diagram</b></size>\n<size:11><color:#555555>Stippelijn = WIT-grens  |  Blok links = WASM sandbox  |  Rechts = host + hardware</color></size>

' ─── Participants ─────────────────────────────────────────────────────────────
box "WASM Sandbox" #EEF5FF
    participant "webcam.wasm\n(run_webcam)" <<guest>> as G
end box

participant "WIT\n(component:usb@0.2.1)" <<wit>> as W

box "Host Runtime" #EFFFEF
    participant "usb-wasi-host\n(HostDeviceHandle\n/ HostTransfer)" <<host>> as H
end box

participant "USB Device\n(Logitech Brio)" <<hw>> as USB

' ─── Phase 1: Initialization ─────────────────────────────────────────────────
== <color:#1A3D6E>① Initialisatie & device discovery</color> ==

G -> W : device::init()
W -> H : libusb_init()

G -> W : device::list_devices()
W -> H : libusb_get_device_list()
H --> W : [UsbDevice resources]\n(gefilterd op AllowedUSBDevices)
W --> G : [(Device, Descriptor, Location)]

G -> W : dev.open()
W -> H : libusb_open()
H --> W : DeviceHandle resource
W --> G : Resource<DeviceHandle>

G -> W : claim_interface(VS_iface)
G -> W : set_altsetting(VS_iface, 0)\n<color:#888888>← zero-bandwidth alt</color>

' ─── Phase 2: UVC Negotiation ─────────────────────────────────────────────────
== <color:#7A2800>② UVC Probe/Commit handshake (control transfers)</color> ==

G -> W : new_transfer(Control, GET_CUR Probe)
G -> W : submit_transfer([])
W -> H : libusb_submit_transfer
H -> USB : GET_CUR Probe\n<color:#888888>bmReqType=0xA1, bReq=0x81\nwValue=0x0100</color>
USB --> H : probe_data[34]
H --> W : oneshot::send(Ok(data))
G -> W : await_transfer(&xfer)
W --> G : TransferResult { data: probe_data }

note over G : bFormatIndex = 2 (MJPEG)\nbFrameIndex = 1

G -> W : new_transfer(Control, SET_CUR Probe)
G -> W : submit_transfer(probe_data)
W -> USB : SET_CUR Probe\n<color:#888888>bmReqType=0x21, bReq=0x01</color>
G -> W : await_transfer(&xfer)

G -> W : new_transfer(Control, GET_CUR Probe)
G -> W : await_transfer(&xfer)
W --> G : negotiated[34]\n<color:#888888>← inclusief dwMaxVideoFrameSize</color>

G -> W : new_transfer(Control, SET_CUR Commit)
G -> W : submit_transfer(negotiated)
W -> USB : SET_CUR Commit\n<color:#888888>wValue=0x0200</color>
G -> W : await_transfer(&xfer)

G -> W : set_altsetting(VS_iface, alt)\n<color:#888888>← hoge bandbreedte ISO endpoint actief</color>

' ─── Phase 3: Capture loop ────────────────────────────────────────────────────
== <color:#1B4A1B>③ Isochrone capture-lus  (per frame: tot 2000 transfers)</color> ==

loop 32 paketten per transfer, tot volledige JPEG frame
    G -> W : new_transfer(Isochronous,\n32 pkts × max_packet_size)
    G -> W : submit_transfer([])
    W -> H : libusb_submit_transfer
    H -> USB : ISO IN burst\n<color:#888888>(32 × stride bytes)</color>
    USB --> H : raw ISO paketten
    note over H : transfer_callback:\nkopieer volledig stride-buffer\nper-packet actual_length opslaan
    H --> W : oneshot::send(Ok(flat_data))
    G -> W : await_transfer(&xfer)
    W --> G : TransferResult {\n  data: flat_buffer,\n  packets: [IsoPacket × 32]\n}

    alt FID-bit togglet  →  frame volledig
        note over G : std::mem::take(&mut frame_buffer)\nis_complete_jpeg(SOI..EOI) ✓
    else EOF-bit  →  frame volledig
        note over G : idem
    else onvolledig pakket
        note over G : eprintln!("dropped …")\ndoorgaan
    end
end

' ─── Phase 4: Output ──────────────────────────────────────────────────────────
== <color:#5C4000>④ Output</color> ==

G -> G : std::fs::write(\n"out/latest.jpg",\nframe.data\n)
note right of G : via WASI filesystem\n(preopened dir ".")\nHost ziet geen UVC, MJPEG\nof frame-grenzen

@enduml
