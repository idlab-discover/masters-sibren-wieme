@startuml webcam_seq_minimal
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBorderThickness 1.2
skinparam SequenceGroupFontSize 12
skinparam SequenceGroupFontStyle bold
skinparam SequenceArrowThickness 1.4

skinparam participant {
    BackgroundColor<<g>>   #C5D8F6
    BorderColor<<g>>       #3D6FCC
    FontColor<<g>>         #1A3560
    BackgroundColor<<wit>> #FFE0B2
    BorderColor<<wit>>     #E65100
    FontColor<<wit>>       #7A2800
    BackgroundColor<<h>>   #C8E6C9
    BorderColor<<h>>       #2E7D32
    FontColor<<h>>         #1B4A1B
    BackgroundColor<<hw>>  #FFF9C4
    BorderColor<<hw>>      #F9A825
    FontColor<<hw>>        #5C4000
}

box "WASM Sandbox" #E8F0FE
    participant "webcam.wasm" <<g>> as G
end box
participant "WIT" <<wit>> as W
box "Host Runtime" #E6F4EA
    participant "usb-wasi-host" <<h>> as H
end box
participant "USB Camera" <<hw>> as USB

== Discovery ==
G -> W : list_devices()
W -> H : libusb_get_device_list
H --> G : [UsbDevice]
G -> W : dev.open()
W --> G : DeviceHandle
G -> W : claim_interface(1)

== UVC Probe/Commit ==
G -> W : new_transfer(Control, GET_CUR)
G -> W : submit + await_transfer
W -> USB : GET_CUR Probe
USB --> G : probe_data[34]
G -> W : submit + await_transfer
W -> USB : SET_CUR Probe\nSET_CUR Commit
G -> W : set_altsetting(alt)

== ISO Capture ==
loop per frame
    G -> W : new_transfer(Isochronous, 32 pkts)
    G -> W : submit + await_transfer
    W -> USB : ISO IN
    USB --> G : TransferResult\n{ data, packets[] }
    G -> G : FID/EOF\nreassembly
end

== Output ==
G -> G : fs::write("out/latest.jpg")

@enduml
